{
  "name": "Apuracao",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa associada"
    },
    "periodo": {
      "type": "string",
      "description": "Per\u00edodo da apura\u00e7\u00e3o no formato MM/YYYY"
    },
    "tipo_arquivo": {
      "type": "string",
      "enum": [
        "dominio_simples",
        "dominio_entradas"
      ],
      "description": "Tipo do arquivo de origem"
    },
    "receita_bruta_periodo": {
      "type": "number",
      "description": "Receita Bruta do per\u00edodo (RPA)"
    },
    "receita_bruta_acumulada_12m": {
      "type": "number",
      "description": "Receita Bruta Acumulada 12 meses (RBT12)"
    },
    "receita_bruta_ano_corrente": {
      "type": "number",
      "description": "Receita Bruta Acumulada ano corrente"
    },
    "receita_bruta_ano_anterior": {
      "type": "number",
      "description": "Receita Bruta Acumulada ano anterior"
    },
    "faixa_enquadramento": {
      "type": "string",
      "description": "Faixa de enquadramento do Simples Nacional"
    },
    "total_entradas": {
      "type": "number",
      "description": "Valor Cont\u00e1bil total das entradas"
    },
    "base_calculo_icms_entradas": {
      "type": "number",
      "description": "Base de C\u00e1lculo do ICMS nas entradas"
    },
    "valor_icms_entradas": {
      "type": "number",
      "description": "Valor do ICMS nas entradas"
    },
    "total_saidas_comercio": {
      "type": "number",
      "description": "Receita de revenda (Anexo I)"
    },
    "total_saidas_st": {
      "type": "number",
      "description": "Receita com ST (Anexo I, Se\u00e7\u00e3o II)"
    },
    "total_saidas_sem_st": {
      "type": "number",
      "description": "Receita sem ST (Anexo I, Se\u00e7\u00e3o I)"
    },
    "total_servicos": {
      "type": "number",
      "description": "Receita de servi\u00e7os (Anexo III)"
    },
    "simples_nacional_total": {
      "type": "number",
      "description": "Valor total a recolher do Simples Nacional"
    },
    "aliquota_efetiva": {
      "type": "number",
      "description": "Al\u00edquota efetiva m\u00e9dia ponderada (%)"
    },
    "fator_r": {
      "type": "number",
      "description": "Fator R"
    },
    "valor_irpj": {
      "type": "number",
      "description": "Valor do IRPJ"
    },
    "valor_csll": {
      "type": "number",
      "description": "Valor da CSLL"
    },
    "valor_cofins": {
      "type": "number",
      "description": "Valor do COFINS"
    },
    "valor_pis": {
      "type": "number",
      "description": "Valor do PIS"
    },
    "valor_cpp": {
      "type": "number",
      "description": "Valor da CPP (INSS)"
    },
    "valor_icms": {
      "type": "number",
      "description": "Valor do ICMS"
    },
    "valor_iss": {
      "type": "number",
      "description": "Valor do ISS"
    },
    "historico_12m": {
      "type": "array",
      "description": "Hist\u00f3rico de receita bruta 12 meses",
      "items": {
        "type": "object",
        "properties": {
          "periodo": {
            "type": "string"
          },
          "receita_bruta": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "empresa_id",
    "periodo"
  ]
}